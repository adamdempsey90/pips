# Lorenz attractor
#
# System (sigma=10, rho=28, beta=8/3):
#   y0' = sigma * (y1 - y0)
#   y1' = y0 * (rho - y2) - y1
#   y2' = y0 * y1 - beta * y2
#
# Run:
#   ./applications/ode_solver applications/lorenz.pips > lorenz.csv

var sigma = 10.0;
var rho   = 28.0;
var beta  = 8.0 / 3.0;

var time_range = linspace(0, 25, 5001);
var dimension  = 3;

fn initial_condition() {
    return [1.0, 0.0, 0.0];
}

fn rhs(t, y) {
    var dy0 = sigma * (y[1] - y[0]);
    var dy1 = y[0] * (rho - y[2]) - y[1];
    var dy2 = y[0] * y[1] - beta * y[2];
    return [dy0, dy1, dy2];
}
