{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "pips",
  "scopeName": "source.pips",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#inspectors"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#members"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#delimiters"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pips",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pips",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pips",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.pips",
          "match": "(?x)(?<![\\w.])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eEdD][+-]?\\d+)?(?![\\w.])"
        }
      ]
    },
    "inspectors": {
      "patterns": [
        {
          "name": "support.function.inspect.pips",
          "match": "\\b(?:__list__|__globals__|__locals__|__stack__|__funcs__)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.class.pips",
          "match": "\\b(class)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.pips"
            },
            "2": {
              "name": "entity.name.type.class.pips"
            }
          }
        },
        {
          "name": "meta.function.pips",
          "match": "\\b(fn)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.pips"
            },
            "2": {
              "name": "entity.name.function.pips"
            }
          }
        },
        {
          "name": "meta.instantiation.pips",
          "match": "\\b(new)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.new.pips"
            },
            "2": {
              "name": "support.class.pips"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.pips",
          "match": "\\b(?:print|setattr|getattr|hasattr|str|exp|sin|cos|tan|abs|log|log10|sign|sqrt|acos|asin|atan|ceil|floor|env|atan2|min|max)\\b(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pips",
          "match": "\\b(?:if|else|for|while|return|and|or|not|new|this|super)\\b"
        },
        {
          "name": "storage.modifier.pips",
          "match": "\\b(?:var|fn|class)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.pips",
          "match": "\\b(?:true|false|nil|pi)\\b"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "variable.other.member.pips",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pips",
          "match": "\\+\\+|--|<<=|>>=|\\+=|-=|\\*=|/=|%=|\\|=|&=|\\*\\*|//|==|!=|>=|<=|<<|>>|[+\\-*/%<>=!?~^|&:]"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.pips",
          "match": "[,;]"
        },
        {
          "name": "punctuation.bracket.pips",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}